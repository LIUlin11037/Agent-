# 复制本文件为 .env 后填写。.env 已在 .gitignore 中，不会被提交。
# 代码里不出现任何密钥，只从环境变量读取。

# 必填：DeepSeek（或其他 OpenAI 兼容服务）的 API Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：接口地址与模型名
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 可选：Agent 行为参数
AGENT_MAX_STEPS=8
AGENT_MAX_CONTEXT_TOKENS=12000
AGENT_COMPRESS_THRESHOLD=0.7
AGENT_KEEP_RECENT_TURNS=6
AGENT_MAX_TOOL_OUTPUT=4000

# 可选：待办归属。user = 同用户多窗口共享（默认）；session = 严格按窗口隔离
AGENT_TODO_SCOPE=user
